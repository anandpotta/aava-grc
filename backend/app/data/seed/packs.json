{
  "frameworks": [
    {
      "id": "soc2",
      "name": "SOC 2 (Trust Services Criteria)",
      "kind": "Attestation report",
      "issuer": "AICPA",
      "summary": "An independent auditor's report on how well a service organisation protects customer data. Customers of SaaS, cloud and payment platforms ask for it.",
      "note": "Type I tests design at one date. Type II tests that controls worked every day over 3 to 12 months, so controls must be tested and effective for the whole period.",
      "criteria": [
        {
          "id": "CC1",
          "title": "Control environment and oversight",
          "matter": "Governance and accountability",
          "evidence": "Board and committee minutes, org chart, charter"
        },
        {
          "id": "CC1.4",
          "title": "Competence and training",
          "matter": "People and training",
          "evidence": "Training completion reports, screening records"
        },
        {
          "id": "CC6.1",
          "title": "Logical access",
          "matter": "Access control",
          "evidence": "Quarterly access review sign-offs, MFA settings, leaver tickets"
        },
        {
          "id": "CC6.7",
          "title": "Data protected in transit and at rest",
          "matter": "Confidentiality and encryption",
          "evidence": "Encryption configuration, key management records"
        },
        {
          "id": "CC7.1",
          "title": "Vulnerability and threat monitoring",
          "matter": "Cyber security",
          "evidence": "Scan reports, remediation tickets, pen-test report"
        },
        {
          "id": "CC7.3",
          "title": "Incident response",
          "matter": "Operational resilience",
          "evidence": "Incident log, post-incident reviews"
        },
        {
          "id": "CC8.1",
          "title": "Change management",
          "matter": "Change management",
          "evidence": "Change tickets with approvals, release logs"
        },
        {
          "id": "CC9.2",
          "title": "Vendor risk",
          "matter": "Outsourcing and third party",
          "evidence": "Vendor due diligence files, vendor SOC reports"
        },
        {
          "id": "A1",
          "title": "Availability",
          "matter": "Availability and backup",
          "evidence": "Uptime reports, backup restore test results"
        },
        {
          "id": "C1",
          "title": "Confidentiality: retention and disposal",
          "matter": "Records and retention",
          "evidence": "Retention schedule, disposal certificates"
        },
        {
          "id": "P1-P8",
          "title": "Privacy",
          "matter": "Data privacy",
          "evidence": "Privacy notice, consent and request logs"
        },
        {
          "id": "PI1",
          "title": "Processing integrity",
          "matter": "Fraud and payments",
          "evidence": "Reconciliations, error-handling logs"
        }
      ]
    },
